# Brewfile.personal - Full personal Mac setup
# Only run on your own machines
#
# Note: CLI tools (bat, fd, rg, jq, jj, zoxide, neovim) managed by mise; ansible by uv
# Note: GUI apps that auto-update (Spotify, Signal, Zed, etc.) installed manually

# Development
brew "gh"
brew "colima"
brew "docker"
brew "docker-compose"
brew "docker-buildx"
brew "postgresql@14"

# Tools
brew "tmux"
cask "ollama-app"
brew "terminal-notifier"

# Window management
tap "nikitabobko/tap"
tap "felixkratz/formulae"
brew "borders"

# Automation & keyboard
cask "hammerspoon"
cask "keymapp"
brew "kanata"

# Terminal
