#!/usr/bin/env python3
"""Queue a checkout path, or run queued Asimov scans under the user LaunchAgent."""
import fcntl
import os
from pathlib import Path
import sqlite3
import subprocess
import sys
import time
import uuid


def scan(root):
    print(f'Scanning {root or "scheduled sweep"}', flush=True)
    result = subprocess.run(
        ['gtimeout', '--foreground', '-k', '10', '21600', 'asimov', '--no-cache', *([root] if root else [])],
        stdin=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True,
    )
    if result.returncode in (124, 137):
        # End the launchd job so it also reaps any remaining scan descendants.
        raise SystemExit(result.returncode)
    # Asimov can report failed exclusions on stderr while returning zero.
    if result.stderr:
        print(result.stderr, file=sys.stderr, end='')
    if result.returncode or result.stderr:
        print(f'Backup exclusions incomplete: {root or "scheduled sweep"}', file=sys.stderr)
        return False
    return True


def main():
    os.umask(0o077)
    state = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'backup-exclusions'
    state.mkdir(parents=True, exist_ok=True)
    with sqlite3.connect(state / 'queue.sqlite3', timeout=2) as db:
        db.executescript('''
            CREATE TABLE IF NOT EXISTS jobs (root TEXT PRIMARY KEY, token TEXT NOT NULL);
            CREATE TABLE IF NOT EXISTS sweeps (id INTEGER PRIMARY KEY, completed REAL);
            INSERT OR IGNORE INTO sweeps VALUES (1, 0);
        ''')
        if len(sys.argv) != 2:
            raise SystemExit('Usage: backup-exclusions <checkout> | --run')
        if sys.argv[1] != '--run':
            root = Path(sys.argv[1]).resolve(strict=True)
            if not (root / '.git').exists():
                raise SystemExit(f'Not a checkout: {root}')
            with db:
                db.execute('INSERT OR REPLACE INTO jobs VALUES (?, ?)', (str(root), uuid.uuid4().hex))
            subprocess.run(['launchctl', 'kickstart', f'gui/{os.getuid()}/co.kirkconsulting.backup-exclusions'],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2, check=False)
            return 0
        with (state / 'worker.lock').open('a') as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return 0
            success = True
            for root, token in db.execute('SELECT root, token FROM jobs').fetchall():
                if not (Path(root) / '.git').exists() or scan(root):
                    with db:
                        # A request made during this scan belongs to the next run.
                        db.execute('DELETE FROM jobs WHERE root = ? AND token = ?', (root, token))
                else:
                    success = False
            if time.time() - db.execute('SELECT completed FROM sweeps WHERE id = 1').fetchone()[0] >= 900:
                if scan(None):
                    with db:
                        db.execute('UPDATE sweeps SET completed = ? WHERE id = 1', (time.time(),))
                else:
                    success = False
            return 0 if success else 1


if __name__ == '__main__':
    raise SystemExit(main())
