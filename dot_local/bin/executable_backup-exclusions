#!/usr/bin/env python3
"""Queue dependency exclusions; retain Asimov for checkout and nightly catch-up scans."""
from concurrent.futures import ThreadPoolExecutor, wait
import ctypes
import ctypes.util
import fcntl
from functools import lru_cache
import os
from pathlib import Path
import sqlite3
import subprocess
import sys
import time
import uuid


def dependency(path):
    return path.name in ('.venv', 'node_modules') or path.parts[-2:] == ('.moon', 'cache')


@lru_cache(maxsize=1)
def marker():
    cf = ctypes.CDLL(ctypes.util.find_library('CoreFoundation'))
    cs = ctypes.CDLL(ctypes.util.find_library('CoreServices'))
    cf.CFURLCreateFromFileSystemRepresentation.restype = ctypes.c_void_p
    cf.CFURLCreateFromFileSystemRepresentation.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_long, ctypes.c_bool]
    cf.CFRelease.argtypes = [ctypes.c_void_p]
    cs.CSBackupIsItemExcluded.restype = ctypes.c_bool
    cs.CSBackupIsItemExcluded.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_bool)]
    cs.CSBackupSetItemExcluded.restype = ctypes.c_int32
    cs.CSBackupSetItemExcluded.argtypes = [ctypes.c_void_p, ctypes.c_bool, ctypes.c_bool]
    return cf, cs


def exclude(path):
    started = time.monotonic()
    try:
        if path.is_symlink() or not dependency(path.resolve(strict=True)):
            raise ValueError(f'Unsafe dependency path: {path}')
        cf, cs = marker()
        raw = os.fsencode(path)
        url = cf.CFURLCreateFromFileSystemRepresentation(None, raw, len(raw), True)
        if not url:
            raise ValueError(f'Cannot create file URL: {path}')
        try:
            already = cs.CSBackupIsItemExcluded(url, None)
            if not already:
                status = cs.CSBackupSetItemExcluded(url, True, False)
                if status:
                    raise OSError(status, f'Cannot exclude {path}')
        finally:
            cf.CFRelease(url)
        print(f'Direct exclusion in {time.monotonic() - started:.3f}s (new={not already}): {path}', flush=True)
        return True
    except FileNotFoundError:
        return True
    except (OSError, ValueError) as error:
        print(error, file=sys.stderr)
        return False


def scan(root):
    started = time.monotonic()
    print(f'Scanning {root or "scheduled sweep"}', flush=True)
    result = subprocess.run(
        ['gtimeout', '--foreground', '-k', '10', '21600', 'asimov', '--no-cache', *([root] if root else [])],
        stdin=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True,
    )
    if result.returncode in (124, 137):
        # End the launchd job so it also reaps any remaining scan descendants.
        raise SystemExit(result.returncode)
    print(f'Scan finished in {time.monotonic() - started:.1f}s: {root}', flush=True)
    # Worktrees can disappear between Asimov finding a path and excluding it.
    suffix = ': read-only, cannot be excluded — skipping.'
    result.stderr = ''.join(line for line in result.stderr.splitlines(keepends=True)
                            if not (line.startswith('! ') and line.rstrip().endswith(suffix)
                                    and not os.path.lexists(line.rstrip()[2:-len(suffix)])))
    # Asimov can report failed exclusions on stderr while returning zero.
    if result.stderr:
        print(result.stderr, file=sys.stderr, end='')
    if result.returncode or result.stderr:
        print(f'Backup exclusions incomplete: {root or "scheduled sweep"}', file=sys.stderr)
        return False
    return True


def full_scan():
    roots = ('Work', '.t3/worktrees', '.t3/scratch', '.codex/worktrees', '.codex-workspaces/worktrees')
    return [scan(str(Path.home() / root)) for root in roots if (Path.home() / root).is_dir()]


def drain(db, attempted):
    success = True
    for root, token in db.execute('SELECT root, token FROM jobs').fetchall():
        if (root, token) in attempted:
            continue
        attempted.add((root, token))
        path = Path(root)
        done = exclude(path) if dependency(path) else not (path / '.git').exists() or scan(root)
        if done:
            with db:
                # Preserve a newer request for the same path.
                db.execute('DELETE FROM jobs WHERE root = ? AND token = ?', (root, token))
        else:
            success = False
    return success


def main():
    os.umask(0o077)
    state = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'backup-exclusions'
    state.mkdir(parents=True, exist_ok=True)
    with sqlite3.connect(state / 'queue.sqlite3', timeout=2) as db:
        db.executescript('''
            CREATE TABLE IF NOT EXISTS jobs (root TEXT PRIMARY KEY, token TEXT NOT NULL);
            CREATE TABLE IF NOT EXISTS sweeps (id INTEGER PRIMARY KEY, completed REAL);
            INSERT OR IGNORE INTO sweeps VALUES (1, 0);
        ''')
        if len(sys.argv) < 2:
            raise SystemExit('Usage: backup-exclusions <checkout> [dependency-directory...] | <dependency-directory>... | --run')
        if sys.argv[1] != '--run':
            roots = []
            for argument in sys.argv[1:]:
                path = Path(argument)
                root = path.resolve(strict=True)
                if path.is_symlink() or not root.is_dir() or not (dependency(root) or (root / '.git').exists()):
                    raise SystemExit(f'Not a dependency directory or checkout: {path}')
                roots.append(root)
            if len(roots) > 1 and (roots[0] / '.git').exists():
                # Root-only calls still request a scan; hints avoid rescanning the checkout.
                cache = roots.pop(0) / '.moon/cache'
                if cache.is_dir() and not cache.is_symlink() and dependency(cache.resolve()):
                    roots.append(cache)
            with db:
                db.executemany('INSERT OR REPLACE INTO jobs VALUES (?, ?)',
                               [(str(root), uuid.uuid4().hex) for root in roots])
            # Wake the worker now through the job supervisor; the schedule is the fallback.
            # A verity dev shell's PITCHFORK_STATE_DIR names its own worktree supervisor.
            env = {k: v for k, v in os.environ.items() if k != 'PITCHFORK_STATE_DIR'}
            env['PITCHFORK_CONFIG_DIR'] = str(Path.home() / '.config/pitchfork-jobs')
            try:
                # As the supervisor's agent runs it: the pinned pitchfork, whatever the caller's PATH.
                subprocess.Popen([str(Path.home() / '.local/bin/mise'), 'x', '--', 'pitchfork', 'start', 'backup-exclusions'],
                                 cwd='/', env=env,
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
            except OSError:
                pass
            return 0
        with (state / 'worker.lock').open('a') as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return 0
            attempted = set()
            success = drain(db, attempted)
            now = time.localtime(time.time())
            completed = time.localtime(db.execute('SELECT completed FROM sweeps WHERE id = 1').fetchone()[0])
            if now.tm_hour == 3 and now[:3] != completed[:3]:
                with ThreadPoolExecutor(max_workers=1) as pool:
                    sweep = pool.submit(full_scan)
                    while not sweep.done():
                        success = drain(db, attempted) and success
                        wait([sweep], timeout=1)
                    success = drain(db, attempted) and success
                    results = sweep.result()
                if all(results):
                    with db:
                        db.execute('UPDATE sweeps SET completed = ? WHERE id = 1', (time.time(),))
                else:
                    success = False
            return 0 if success else 1


if __name__ == '__main__':
    raise SystemExit(main())
