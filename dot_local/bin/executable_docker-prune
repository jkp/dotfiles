#!/bin/bash
# Remove build cache unused for 7 days and untagged images older than 7 days,
# then trim Colima's disk so the freed space returns to macOS (its disk image
# never shrinks on its own). Tagged images stay: Docker can't say when one was
# last used, so docker-image-use records that first. Volumes hold data and stay.
# Run weekly by the pitchfork docker-prune job.
set -uo pipefail

colima status >/dev/null 2>&1 || { echo "Colima is not running; nothing to prune."; exit 0; }
status=0
echo "Before:"; docker system df || status=1
docker image prune -f --filter until=168h | tail -1 || status=1
# Build cache "until" counts from last use, not creation.
docker builder prune -a -f --filter until=168h | tail -1 || status=1
colima ssh -- sudo fstrim -av || status=1
echo "After:"; docker system df || status=1
[ "$status" = 0 ] || echo "A prune or trim step failed; see above." >&2
exit "$status"
