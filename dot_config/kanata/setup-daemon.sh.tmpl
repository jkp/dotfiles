#!/bin/bash
# Install kanata's root parts for this Mac's kanata.mode (chezmoi data):
#   always       daemon starts at boot and is kept alive
#   active-user  daemon starts and stops with this user's console session
#                (Hammerspoon, via a start/stop-only sudoers rule)
#   off          remove them
# Idempotent. Without sudo or a terminal it prints the commands to run.
#
#   bash ~/.config/kanata/setup-daemon.sh [always|active-user|off]
set -euo pipefail

MODE="${1:-{{ dig "kanata" "mode" "always" . }}}"
USERNAME=$(whoami)
R="${KANATA_SETUP_ROOT:-}" # tests point this at a fake root
KANATA_BIN="$(command -v kanata || true)"
KANATA_CFG="$HOME/.config/kanata/colemak-dh-iso.kbd"
LABEL=com.kanata
PLIST="$R/Library/LaunchDaemons/$LABEL.plist"
WRAPPER="$R/usr/local/libexec/kanata-active-user"
SUDOERS="$R/etc/sudoers.d/kanata-$USERNAME"
# Karabiner-Elements ships the same driver and, while it works, its own daemon for it.
VHID_DAEMON="$R/Library/Application Support/org.pqrs/Karabiner-DriverKit-VirtualHIDDevice/Applications/Karabiner-VirtualHIDDevice-Daemon.app/Contents/MacOS/Karabiner-VirtualHIDDevice-Daemon"
VHID_PLIST="$R/Library/LaunchDaemons/org.pqrs.Karabiner-VirtualHIDDevice-Daemon.plist"
KARABINER_VHID=org.pqrs.service.daemon.Karabiner-VirtualHIDDevice-Daemon
KARABINER_ELEMENTS="$R/Applications/Karabiner-Elements.app"
VHID_MANAGER="$R/Applications/.Karabiner-VirtualHIDDevice-Manager.app/Contents/MacOS/Karabiner-VirtualHIDDevice-Manager"
# ponytail: pinned to v6 for kanata < 1.13; bump with kanata.
VHID_PKG_VERSION=6.5.0
VHID_PKG_SHA256=738893c0ff52d45990f8b1c6a9f984ef53e25140d1cf259cfad82a755b32db2f
VHID_PKG_URL="https://github.com/pqrs-org/Karabiner-DriverKit-VirtualHIDDevice/releases/download/v$VHID_PKG_VERSION/Karabiner-DriverKit-VirtualHIDDevice-$VHID_PKG_VERSION.pkg"
STAGE="$HOME/.cache/kanata-setup"
LOG="$R/tmp/kanata"
VERIFY_WAIT="${KANATA_VERIFY_WAIT:-8}" # seconds to watch a restarted kanata
console_user() { stat -f %Su "${KANATA_CONSOLE:-/dev/console}"; }

case "$MODE" in always|active-user|off) ;; *) echo "Unknown kanata mode: $MODE" >&2; exit 1 ;; esac

# Root commands run via sudo when it won't hang, else they're printed.
if sudo -n true 2>/dev/null || [[ -t 0 ]]; then CAN_SUDO=1; else CAN_SUDO=; fi
PRINTED=
root() {
    if [[ -n "$CAN_SUDO" ]]; then sudo "$@"; return; fi
    [[ -n "$PRINTED" ]] || { echo "No sudo without a terminal; run these in one:"; PRINTED=1; }
    echo "  sudo $*"
}
# same <src> <dest>: is dest already src? (sudoers.d is root-only)
same() {
    if [[ -n "$CAN_SUDO" ]]; then sudo cmp -s "$1" "$2"; else cmp -s "$1" "$2" 2>/dev/null; fi
}
put() { # put <mode> <src> <dest>
    same "$2" "$3" && return
    root install -m "$1" -o root -g wheel "$2" "$3"
}
loaded() { launchctl print "system/$1" >/dev/null 2>&1; }
remove() { # remove <path>...: the ones that exist
    local p have=()
    for p in "$@"; do [[ -e "$p" ]] && have+=("$p"); done
    [[ ${#have[@]} -eq 0 ]] || root rm -f "${have[@]}"
}

if [[ "$MODE" == off ]]; then
    loaded "$LABEL" && root launchctl bootout "system/$LABEL"
    remove "$PLIST" "$SUDOERS" "$WRAPPER"
    exit 0
fi

[[ -x "$KANATA_BIN" ]] || { echo "Error: kanata not on PATH (brew install kanata)" >&2; exit 1; }
KANATA_REAL="$(readlink -f "$KANATA_BIN")" # macOS grants pin this path, not the brew symlink
[[ -f "$KANATA_CFG" ]] || { echo "Error: config not found at $KANATA_CFG" >&2; exit 1; }
mkdir -p "$STAGE"
# kanata < 1.13 pairs with driver v6.x: https://github.com/pqrs-org/Karabiner-DriverKit-VirtualHIDDevice/releases
vhid_version() {
    [[ -x "$VHID_DAEMON" ]] || return 0
    plutil -extract CFBundleShortVersionString raw -o - "${VHID_DAEMON%/MacOS/*}/Info.plist" 2>/dev/null || echo unknown
}
VHID_VERSION="$(vhid_version)"
if [[ "$VHID_VERSION" != 6.* ]]; then
    if [[ -n "$VHID_VERSION" && -d "$KARABINER_ELEMENTS" ]]; then
        echo "Error: Karabiner-Elements is installed with VirtualHIDDevice driver $VHID_VERSION, but kanata < 1.13 needs v6.x." >&2
        echo "Uninstall Karabiner-Elements (Settings → Misc → Uninstall), then rerun this to install the v6 driver." >&2
        exit 1
    fi
    echo "Installing Karabiner VirtualHIDDevice driver $VHID_PKG_VERSION (have: ${VHID_VERSION:-none})"
    pkg="$STAGE/Karabiner-DriverKit-VirtualHIDDevice-$VHID_PKG_VERSION.pkg"
    if [[ -n "$CAN_SUDO" ]]; then
        curl -fsSL -o "$pkg" "$VHID_PKG_URL"
        echo "$VHID_PKG_SHA256  $pkg" | shasum -a 256 -c >/dev/null ||
            { rm -f "$pkg"; echo "Error: $VHID_PKG_URL doesn't match its pinned checksum" >&2; exit 1; }
    else
        [[ -n "$PRINTED" ]] || { echo "No sudo without a terminal; run these in one:"; PRINTED=1; }
        echo "  curl -fsSL -o $pkg $VHID_PKG_URL"
        echo "  echo '$VHID_PKG_SHA256  $pkg' | shasum -a 256 -c"
    fi
    root installer -pkg "$pkg" -target /
    root "$VHID_MANAGER" forceActivate
    if [[ -n "$CAN_SUDO" && "$(vhid_version)" != 6.* ]]; then
        echo "Error: driver still not v6. Approve it in System Settings → General → Login Items & Extensions, then rerun." >&2
        exit 1
    fi
fi

daemon_plist() { # daemon_plist <label> <extra keys> <log> <program args...>
    local label="$1" extra="$2" log="$3" arg; shift 3
    cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$label</string>
    <key>ProgramArguments</key>
    <array>
$(for arg in "$@"; do echo "        <string>$arg</string>"; done)
    </array>
    <key>UserName</key>
    <string>root</string>
$extra    <key>StandardOutPath</key>
    <string>$log.log</string>
    <key>StandardErrorPath</key>
    <string>$log.err</string>
</dict>
</plist>
PLIST
}
ALWAYS='    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
'

if ! loaded "$KARABINER_VHID" && [[ ! -f "$VHID_PLIST" ]]; then
    daemon_plist org.pqrs.Karabiner-VirtualHIDDevice-Daemon "$ALWAYS" /var/log/karabiner-vhid-daemon "$VHID_DAEMON" \
        > "$STAGE/org.pqrs.Karabiner-VirtualHIDDevice-Daemon.plist"
    put 0644 "$STAGE/org.pqrs.Karabiner-VirtualHIDDevice-Daemon.plist" "$VHID_PLIST"
    root launchctl bootstrap system "$VHID_PLIST"
fi

if [[ "$MODE" == always ]]; then
    daemon_plist "$LABEL" "$ALWAYS" "$LOG" "$KANATA_BIN" -c "$KANATA_CFG" > "$STAGE/$LABEL.plist"
    remove "$SUDOERS" "$WRAPPER"
else
    # No RunAtLoad/KeepAlive: Hammerspoon starts it, the wrapper ends it.
    daemon_plist "$LABEL" "" "$LOG" "$WRAPPER" "$USERNAME" "$KANATA_BIN" -c "$KANATA_CFG" > "$STAGE/$LABEL.plist"
    cp "$HOME/.config/kanata/kanata-active-user" "$STAGE/kanata-active-user"
    cat > "$STAGE/sudoers" <<SUDOERS
# Lets $USERNAME's Hammerspoon start and stop kanata (setup-daemon.sh, active-user mode)
$USERNAME ALL=(root) NOPASSWD: /bin/launchctl kickstart system/$LABEL, /bin/launchctl kill TERM system/$LABEL
SUDOERS
    visudo -cf "$STAGE/sudoers" >/dev/null # a broken drop-in breaks sudo
    [[ -d "$(dirname "$WRAPPER")" ]] || root mkdir -p "$(dirname "$WRAPPER")"
    put 0755 "$STAGE/kanata-active-user" "$WRAPPER"
    put 0440 "$STAGE/sudoers" "$SUDOERS"
fi
LAUNCHD_CHANGED=
same "$STAGE/$LABEL.plist" "$PLIST" || LAUNCHD_CHANGED=1
put 0644 "$STAGE/$LABEL.plist" "$PLIST"

if [[ -n "$LAUNCHD_CHANGED" ]] || ! loaded "$LABEL"; then
    loaded "$LABEL" && root launchctl bootout "system/$LABEL"
    root launchctl bootstrap system "$PLIST"
fi

if [[ "$MODE" == active-user ]] && ! pgrep -xq Hammerspoon; then
    echo "Hammerspoon isn't running, and it's what starts kanata when you log in or switch back. Opening it: allow Accessibility when it asks."
    open -g -a Hammerspoon || true
fi

# grant <pane anchor> <name shown in System Settings>
grant() {
    printf '%s' "$KANATA_REAL" | pbcopy
    open "x-apple.systempreferences:com.apple.preference.security?$1" || true
    echo "kanata needs \"$2\" (System Settings → Privacy & Security, now open)."
    echo "  Click +, press Cmd+Shift+G, paste (copied) $KANATA_REAL, Open, and switch it on."
    [[ -t 0 ]] || return 1
    read -rp "  Press Enter once it's on... "
}

# Restart kanata and walk through any permission it lacks.
verify() {
    local attempt size said waited
    for attempt in 1 2 3; do
        size=$(stat -f %z "$LOG.err" 2>/dev/null || echo 0)
        root launchctl kickstart -k "system/$LABEL"
        said=
        for ((waited = 0; waited <= VERIFY_WAIT; waited++)); do
            said="$(tail -c "+$((size + 1))" "$LOG.err" 2>/dev/null || true)"
            [[ "$said" == *permission* ]] && break
            ((waited == VERIFY_WAIT)) || sleep 1
        done
        if [[ "$said" == *"Input Monitoring permission"* ]]; then
            grant Privacy_ListenEvent "Input Monitoring" || return 1
        elif [[ "$said" == *"Accessibility permission"* ]]; then
            grant Privacy_Accessibility "Allow assistive applications to control the computer" || return 1
        elif launchctl print "system/$LABEL" 2>/dev/null | grep -q 'state = running'; then
            echo "✅ kanata is running"
            return 0
        else
            echo "Error: kanata isn't running. $LOG.err says:" >&2
            echo "${said:-(nothing)}" >&2
            return 1
        fi
    done
    echo "Error: kanata still lacks a permission; see $LOG.err" >&2
    return 1
}

if [[ -z "$CAN_SUDO" ]]; then
    echo "Then grant $KANATA_REAL Input Monitoring and Accessibility (\"Allow assistive applications to control the computer\") under System Settings → Privacy & Security, and rerun this to check."
elif [[ "$MODE" == active-user && "$(console_user)" != "$USERNAME" ]]; then
    echo "Installed. kanata starts next time you're the active user."
else
    verify
fi
