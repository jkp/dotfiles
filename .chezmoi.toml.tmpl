{{- /* Only macOS manages encrypted files; Linux applies with --exclude=encrypted. */ -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- /* kanata.mode: always (root daemon at boot), active-user (only while this
       user owns the console; shared Macs) or off. KANATA_MODE wins, then the
       stored value; a Mac with the always-on daemon but no stored mode predates
       modes and stays always. */ -}}
{{- $kanataMode := env "KANATA_MODE" -}}
{{- if not $kanataMode -}}
{{-   $kanataMode = dig "kanata" "mode" "" . -}}
{{- end -}}
{{- /* Without a terminal the mode can't be chosen, so take the safe one:
       active-user acts like always on a single-user Mac (you're always the
       console user) and is the only safe mode on a shared one. */ -}}
{{- if not $kanataMode -}}
{{-   if stat (dig "kanataPlist" "/Library/LaunchDaemons/com.kanata.plist" .) -}}
{{-     $kanataMode = "always" -}}
{{-   else if not stdinIsATTY -}}
{{-     $kanataMode = "active-user" -}}
{{-   else -}}
{{-     $kanataMode = promptChoiceOnce . "kanata.mode" "Kanata mode" (list "always" "active-user" "off") "always" -}}
{{-   end -}}
{{- end -}}
{{- if not (has $kanataMode (list "always" "active-user" "off")) -}}
{{-   fail (printf "kanata mode %q: want always, active-user or off" $kanataMode) -}}
{{- end -}}
encryption = "age"

[age]
    recipient = "age1d2vlx4j2n8lfg589vtacxltl2z5u8s0tg9xvrrcjmvxdsatuvsvqt0wjxq"
    identity = "~/.config/chezmoi/key.txt"

[data.kanata]
    mode = {{ $kanataMode | quote }}
{{ end -}}
