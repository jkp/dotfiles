[user]
    name = {{ .name }}
    email = {{ .email }}

[branch]
    autosetuprebase = always

[color]
    status = auto
    diff = auto
    branch = auto
    ui = true

[merge]
    # http://psung.blogspot.com/2011/02/reducing-merge-headaches-git-meets.html
    conflictstyle = diff3

[core]
    excludesfile = ~/.config/git/ignore
    trustctime = false
    editor = edit

[apply]
    whitespace = nowarn

[push]
    default = current

[rerere]
    enabled = 1

[alias]
    ls = "!f() { git show --pretty=\"format:\" --name-only $1 | grep -v \"^$\"; }; f"
    top = "!f() { git shortlog --numbered --summary | head -n 15; }; f"
    cleanup-branches = !git branch | grep -v \"\\*\" | awk \"{ print $1 }\" | xargs git branch -d
    identity = "! git config user.name \"$(git config user.$1.name)\"; git config user.email \"$(git config user.$1.email)\"; :"

[rebase]
    autosquash = true

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge --skip -- %f
    process = git-lfs filter-process --skip
    required = true

[safe]
    directory = /workspace

[supertest]
    agentHandle = jamie
{{- if lookPath "gh" }}

[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
{{- end }}
{{- $key := joinPath .chezmoi.homeDir ".ssh/git_signing_ed25519" }}
{{- if stat $key }}

# Sign with the on-disk key, never the 1Password agent (see git-sign-with-file.sh).
[user]
    signingkey = {{ $key }}

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = {{ joinPath .chezmoi.homeDir ".ssh/allowed_signers" }}
    program = {{ joinPath .chezmoi.homeDir ".ssh/git-sign-with-file.sh" }}

[commit]
    gpgsign = true
{{- end }}
