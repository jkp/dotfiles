{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Restart the job supervisor whenever its agent or its jobs change.
# plist: {{ include "private_Library/private_LaunchAgents/co.kirkconsulting.pitchfork.plist.tmpl" | sha256sum }}
# jobs: {{ include "dot_config/pitchfork-jobs/config.toml.tmpl" | sha256sum }}
set -euo pipefail
"$HOME/.local/bin/mise" install pitchfork
# Agents whose jobs moved into the jobs config, or were dropped.
for old in accounts-backup-run accounts-backup-stale accounts-backup-verify backup-exclusions network-config-drift safari-tabs-export; do
    launchctl bootout "gui/$(id -u)/co.kirkconsulting.$old" 2>/dev/null || true
done
label=co.kirkconsulting.pitchfork
launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
# bootout returns before the old job has exited, and bootstrap fails (5) until it has.
for _ in $(seq 60); do launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1 || break; sleep 0.5; done
launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/$label.plist"
{{ end -}}
