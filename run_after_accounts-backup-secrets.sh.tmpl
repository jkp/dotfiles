{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Fetch accounts-backup's restic password and R2 key from 1Password into
# owner-only files, once. Runs on every apply but only calls op (Touch ID) when
# they're missing; the backup agents can't call op themselves. To rotate:
# delete ~/.local/state/accounts-backup/{env,password} and apply again.
set -euo pipefail
# Agent-run applies pass --exclude=encrypted and must never call op (it hangs there).
case " ${CHEZMOI_ARGS:-} " in *" --exclude=encrypted "*) exit 0 ;; esac
[[ -s "$HOME/.config/accounts-backup/ntfy-url" ]] ||
    echo "warning: accounts-backup has no alert URL, so its failures will only reach the log." >&2
dir="$HOME/.local/state/accounts-backup"
[[ -s "$dir/env" && -s "$dir/password" ]] && exit 0
umask 077
mkdir -p "$dir" && chmod 700 "$dir"
item="op://Private/accounts-backup"
tmp="$(mktemp -d "$dir/.fetch.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT
if ! { command -v op >/dev/null &&
       op read --no-newline "$item/password" > "$tmp/password" &&
       kid="$(op read "$item/r2_access_key_id")" &&
       sk="$(op read "$item/r2_secret_access_key")" &&
       endpoint="$(op read "$item/r2_endpoint")" &&
       [[ -s "$tmp/password" ]] &&
       # The env file is sourced: accept only values that can't expand or split.
       [[ "$kid" =~ ^[A-Za-z0-9]+$ && "$sk" =~ ^[A-Za-z0-9]+$ && "$endpoint" =~ ^https://[A-Za-z0-9.-]+/?$ ]]; }; then
    echo "warning: couldn't read $item from 1Password, so accounts-backup has no secrets yet." >&2
    echo "  Run chezmoi apply again from a terminal where 1Password can prompt." >&2
    exit 0
fi
printf 'RESTIC_REPOSITORY=s3:%s/accounts-backup\nAWS_ACCESS_KEY_ID=%s\nAWS_SECRET_ACCESS_KEY=%s\nAWS_DEFAULT_REGION=auto\n' \
    "${endpoint%/}" "$kid" "$sk" > "$tmp/env"
mv "$tmp/password" "$dir/password"
mv "$tmp/env" "$dir/env"
{{ end -}}
