{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
# Fetch the age key from 1Password if it's missing or over an hour old.
# chezmoi can't decrypt *.age files without it, so fail here with a clear
# message rather than let chezmoi fail with a decrypt error.
case " $CHEZMOI_ARGS " in *" --exclude=encrypted "*) exit 0 ;; esac

KEY_FILE="$HOME/.config/chezmoi/key.txt"
[ -s "$KEY_FILE" ] && [ -z "$(find "$KEY_FILE" -mmin +60)" ] && exit 0
mkdir -p "$(dirname "$KEY_FILE")"

if command -v op >/dev/null 2>&1 &&
    (umask 077; op read "op://Private/chezmoi-age-key/notesPlain" > "$KEY_FILE.new") &&
    [ -s "$KEY_FILE.new" ]; then
    mv "$KEY_FILE.new" "$KEY_FILE"
    exit 0
fi
rm -f "$KEY_FILE.new"

if [ -s "$KEY_FILE" ]; then
    echo "warning: couldn't refresh the age key from 1Password; using the existing $KEY_FILE" >&2
    exit 0
fi
echo "error: no age key at $KEY_FILE, and 1Password couldn't provide it." >&2
echo "  Install the 1Password CLI (brew install --cask 1password-cli), enable" >&2
echo "  1Password → Settings → Developer → Integrate with 1Password CLI, then rerun." >&2
echo "  Or skip encrypted files: chezmoi apply --exclude=encrypted" >&2
exit 1
{{- end -}}
